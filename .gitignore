# .gitignore Maestro - EduNova AI

# --- GLOBAL ---
.DS_Store
.idea/
.vscode/
*.swp
*.log
*.sqlite3
tmp/
temp/

# --- BACKEND (Python/FastAPI) ---
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/.env
backend/.env.*
backend/.pytest_cache/
backend/htmlcov/
backend/site/
backend/uploads/
backend/static/  # Generado por Flutter build
backend/create_db_mysql_local_DEPRECATED.py # Legacy

# --- FRONTEND (Flutter) ---
frontend_flutter/build/
frontend_flutter/.dart_tool/
frontend_flutter/.flutter-plugins
frontend_flutter/.flutter-plugins-dependencies
frontend_flutter/.pub/
frontend_flutter/.packages
frontend_flutter/pubspec.lock
frontend_flutter/ios/Flutter/Generated.xcconfig
frontend_flutter/ios/Flutter/flutter_export_environment.sh
frontend_flutter/android/.gradle
frontend_flutter/android/local.properties
frontend_flutter/android/key.properties
frontend_flutter/coverage/

# --- DOCKER ---
.dockerignore
*.db
